# Copy to .env and fill in. Never commit the real .env.

# From @BotFather -> /newbot (required)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your numeric user id (message @userinfobot) or a channel id like -1001234567890
TELEGRAM_CHAT_ID=123456789

# Alert when one gold bar costs less than this many in-game dollars
GOLD_THRESHOLD=400000

# Seconds between checks (900 = 15 minutes; the rate only changes at midnight UTC)
POLL_SECONDS=900

# auto | metaforge | wardogshub
GOLD_SOURCE=auto
